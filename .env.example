# Supabase project API URL. This URL is public.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable key (or legacy anon key). This key is designed for browser use;
# Row Level Security must protect every exposed table. Never use a service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public production origin used for canonical URLs and the generated sitemap.
VITE_SITE_URL=https://www.jt-bazar.com

# Optional Nominatim-compatible reverse geocoding endpoint for GPS-to-address lookup.
# Use a hosted or self-managed provider suitable for production traffic; do not use
# the public Nominatim endpoint as a high-volume commercial geocoding backend.
VITE_GEOCODER_REVERSE_ENDPOINT=
VITE_GEOCODER_API_KEY=
